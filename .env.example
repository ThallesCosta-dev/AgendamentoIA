# Diretório de dados (opcional, padrão ./data)
# Os dados são gravados em um arquivo JSON (db.json) dentro deste diretório
DATA_DIR=

# Envio de emails (SMTP)
SMTP_HOST=smtp.seuservidor.br
SMTP_PORT=587
SMTP_USER=usuario@dominio.br
SMTP_PASS=sua_senha_smtp
# true = exigir TLS (porta 465 usa TLS implícito automaticamente)
SMTP_TLS=true
# Remetente exibido nos emails (opcional; pode incluir nome de exibição)
EMAIL_FROM=SalaAgenda <nao-responda@dominio.br>

# Alternativa legada — Gmail com senha de aplicativo (usada se SMTP_* não estiver definido)
# EMAIL_USER=conta@gmail.com
# EMAIL_PASSWORD=senha_de_app_gmail

# Groq (chatbot IA) — chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo (opcional, padrão: llama-3.3-70b-versatile)
GROQ_MODEL=

# IOC Email Processing Configuration
# Email account to monitor for reservation requests
IOC_EMAIL_HOST=imap.gmail.com
IOC_EMAIL_PORT=993
IOC_EMAIL_USER=reservas@ioc.fiocruz.br
IOC_EMAIL_PASSWORD=your_app_password_here
IOC_EMAIL_FOLDER=INBOX
IOC_EMAIL_CHECK_INTERVAL=5
IOC_EMAIL_PROCESSING_ENABLED=true
# Defina como true APENAS se o servidor IMAP usar certificado autoassinado
IOC_EMAIL_ALLOW_SELF_SIGNED=false

# Admin (painel administrativo)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha

# Domínios de email institucionais aceitos (separados por vírgula)
ALLOWED_EMAIL_DOMAINS=fiocruz.br,edu.br

# CORS: origens permitidas separadas por vírgula (vazio = aberto, apenas dev)
CORS_ORIGIN=

# Application Configuration
PORT=3000
APP_URL=http://localhost:8080
PING_MESSAGE=ping
NODE_ENV=development

# Email Processing Settings
# IOC_EMAIL_CHECK_INTERVAL is in minutes (default: 5)
# Set IOC_EMAIL_PROCESSING_ENABLED=false to disable email processing
# IOC_EMAIL_FOLDER defaults to "INBOX" if not specified
